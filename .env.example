# ---------------------------------------------------------------------------
# DutyCalls environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.
# ---------------------------------------------------------------------------

# Supabase project URL (public — safe to ship in the client bundle).
# Find it in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (public by design — data is protected by RLS).
# Find it in: Supabase Dashboard > Project Settings > API > Project API keys > anon
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID public key for Web Push notifications (public).
# Generate with: npx web-push generate-vapid-keys
# Set the private key via: supabase secrets set VAPID_PRIVATE_KEY=...
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
